{
  "name": "api-docs-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Multilingual API documentation portal built with VitePress, Vue 3 and Scalar, with one OpenAPI spec per language.",
  "author": {
    "name": "Rafael Teixeira",
    "email": "rafactx@icloud.com",
    "url": "https://github.com/rafactx"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rafactx/api-docs-starter.git"
  },
  "homepage": "https://api-docs-starter.rafactx.workers.dev",
  "license": "MIT",
  "keywords": [
    "api",
    "documentation",
    "vitepress",
    "vue",
    "scalar",
    "openapi",
    "i18n",
    "template"
  ],
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "typecheck": "vue-tsc --noEmit",
    "deploy": "vitepress build docs && wrangler deploy"
  },
  "dependencies": {
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@scalar/api-reference": "~1.31.18",
    "@types/node": "^26.6.6",
    "lucide-static": "^1.69.0",
    "typescript": "^5.8.3",
    "vitepress": "^1.6.3",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.158.0"
  }
}
